{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["ep_dir", "script_line", "note", "severity"],
    "properties": {
      "ep_dir": {"type": "string"},
      "script_line": {"type": "integer", "minimum": 1},
      "note": {"type": "string"},
      "severity": {"enum": ["info", "suggestion", "warning", "blocking"]}
    }
  }
}
